{
  "name": "vaidhika-dharma",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-doc-cache.mjs",
    "dev": "node scripts/generate-doc-cache.mjs && astro dev",
    "dev:clean": "rm -rf .astro node_modules/.astro && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "generate:rigveda-suktas": "node scripts/generate-rigveda-suktas.mjs",
    "generate:rigveda-suktas:all": "MANDALA_LIMIT=10 node scripts/generate-rigveda-suktas.mjs",
    "generate:rigveda-suktas:root": "SKIP_IAST=1 node scripts/generate-rigveda-suktas.mjs",
    "build:rigveda-verse-index": "node scripts/build-rigveda-verse-index.mjs",
    "add:rigveda-iast": "node scripts/add-rigveda-iast.mjs",
    "build:rigveda-compilation-maps": "node scripts/build-rigveda-compilation-maps.mjs",
    "generate:rigveda-mandala-indexes": "node scripts/generate-rigveda-mandala-indexes.mjs",
    "convert:rigveda-sukta-wrappers": "node scripts/convert-rigveda-sukta-wrappers.mjs",
    "clean:kanva-samhita-data": "node scripts/clean-kanva-samhita-data.mjs",
    "generate:kanva-samhita": "node scripts/generate-kanva-samhita-chapters.mjs",
    "generate:kanva-samhita:index": "KANVA_INDEX_ONLY=1 node scripts/generate-kanva-samhita-chapters.mjs",
    "clean:madhyandina-samhita-data": "node scripts/clean-madhyandina-samhita-data.mjs",
    "generate:madhyandina-samhita": "node scripts/generate-madhyandina-samhita-chapters.mjs",
    "generate:madhyandina-samhita:index": "MADHYANDINA_INDEX_ONLY=1 node scripts/generate-madhyandina-samhita-chapters.mjs",
    "fetch:taittiriya-samhita": "node scripts/fetch-taittiriya-samhita-data.mjs",
    "create:rigveda-sangraha-suktas": "node scripts/create-rigveda-sangraha-suktas.mjs",
    "generate:taittiriya-samhita": "node scripts/generate-taittiriya-kanda-indexes.mjs && node scripts/generate-taittiriya-samhita-chapters.mjs",
    "generate:taittiriya-kanda-indexes": "node scripts/generate-taittiriya-kanda-indexes.mjs",
    "generate:taittiriya-samhita:index": "TAITTIRIYA_INDEX_ONLY=1 node scripts/generate-taittiriya-samhita-chapters.mjs",
    "generate:taittiriya-samhita:root": "TAITTIRIYA_SKIP_IAST=1 node scripts/generate-taittiriya-samhita-chapters.mjs",
    "generate:taittiriya-samhita:iast": "TAITTIRIYA_IAST_ONLY=1 node scripts/generate-taittiriya-samhita-chapters.mjs",
    "fetch:maitrayani-samhita": "node scripts/fetch-maitrayani-samhita-data.mjs",
    "generate:maitrayani-samhita": "node scripts/generate-maitrayani-kanda-indexes.mjs && node scripts/generate-maitrayani-samhita-chapters.mjs",
    "generate:maitrayani-kanda-indexes": "node scripts/generate-maitrayani-kanda-indexes.mjs",
    "generate:maitrayani-samhita:index": "node scripts/generate-maitrayani-samhita-chapters.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.39.3",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "astro-font": "^1.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vm75/inditrans": "^0.7.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
