---
import { AstroFont } from 'astro-font';
---

<head>
	<AstroFont
		config={[
			{
				name: 'Samarkan',
				src: [
					{
						style: 'normal',
						path: './public/fonts/samarkan.ttf',
					},
				],
				preload: false,
				display: 'swap',
				selector: '.site-title',
				fallback: 'serif',
			},
			{
				name: 'Siddhanta',
				src: [
					{ style: 'normal', path: './public/fonts/siddhanta.woff2' },
					{ style: 'normal', path: './public/fonts/siddhanta.woff' },
					{ style: 'normal', path: './public/fonts/siddhanta.ttf' },
				],
				preload: true,
				display: 'swap',
				selector: 'body',
				fallback: 'Georgia, serif',
			},
			{
				name: 'NotoSerifTamil',
				src: [
					{ style: 'normal', path: './public/fonts/NotoSerifTamil.woff2' },
					{ style: 'normal', path: './public/fonts/NotoSerifTamil.woff' },
					{ style: 'normal', path: './public/fonts/NotoSerifTamil.ttf' },
				],
				preload: false,
				display: 'swap',
				selector: 'body',
				fallback: 'Georgia, serif',
			},
		]}
	/>
</head>
