---
import { Card } from '@astrojs/starlight/components';
import { homeContent } from '../data/home';

const { aboutTitle, aboutBody } = homeContent;
---

<div class="about-card home-card">
	<Card title={aboutTitle} icon="information">
		<div class="about-card__body">
			{aboutBody.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</Card>
</div>

<style>
	.about-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.7;
		color: var(--sl-color-gray-2);
	}

	.about-card__body p {
		margin: 0;
	}
</style>
