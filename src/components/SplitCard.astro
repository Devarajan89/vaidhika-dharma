---
import { Card } from '@astrojs/starlight/components';

export type Props = Parameters<typeof Card>[0];
---

<div class="card--fullwidth">
	<Card {...Astro.props}>
		<div class="split">
			<slot />
		</div>
	</Card>
</div>

<style>
  .card--fullwidth {
    --card-bg: var(--color-gray-900); /* Default: rich dark tone */
    grid-column: 1 / -1;
  }

  :global(:root[data-theme='light']) .card--fullwidth {
    --card-bg: var(--color-gray-100); /* Light: soft parchment background */
  }

  .split {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-gray-900); /* Text color based on theme */
    align-items: center;
  }

  .card--fullwidth :global(.card) {
    background-color: var(--card-bg);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 2px 6px rgba(35, 21, 0, 0.06); /* subtle shadow for depth */
  }

  @media screen and (min-width: 78rem) {
    .split {
      flex-direction: row;
      gap: 2.5rem;
    }
    .split > :global(*) {
      margin-top: 0 !important;
      flex: 1;
    }
  }
</style>
