---
const { lastUpdated } = Astro.locals.starlightRoute;
---

{
	lastUpdated && (
		<p>
			{Astro.locals.t('page.lastUpdated')}{' '}
			<time datetime={lastUpdated.toISOString()}>
				{lastUpdated.toLocaleDateString('en-IN', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
					timeZone: 'UTC',
				})}
			</time>
		</p>
	)
}
