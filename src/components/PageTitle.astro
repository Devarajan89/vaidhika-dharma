---
import Breadcrumbs from './Breadcrumbs.astro';
import DocPageNav from './DocPageNav.astro';
import SeoIntro from './SeoIntro.astro';
import ReaderToolbar from './ReaderToolbar.astro';
import { resolveHomeLocale } from '../data/home';

const PAGE_TITLE_ID = '_top';
const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
---

<Breadcrumbs />
<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
<SeoIntro />
{!isSplash && <DocPageNav />}
<ReaderToolbar locale={resolveHomeLocale(Astro.locals.starlightRoute.locale)} />

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
