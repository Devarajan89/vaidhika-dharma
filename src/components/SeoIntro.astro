---
import { getSeoIntro } from '../data/seo-page-copy';
import { isHomeSlug, isSearchSlug } from '../lib/seo';
import { resolveHomeLocale } from '../data/home';

const { entry } = Astro.locals.starlightRoute;
const slug = String(entry.data.slug ?? entry.id);
const locale = resolveHomeLocale(Astro.locals.starlightRoute.locale);
const intro = getSeoIntro(slug, locale, entry.data.title);
const onSearchPage = /\/search\/?$/.test(Astro.url.pathname);

if (
	!intro ||
	onSearchPage ||
	isHomeSlug(slug) ||
	isSearchSlug(slug) ||
	entry.data.template === 'splash'
) {
	return;
}
---

<p class="seo-intro">{intro}</p>

<style>
	.seo-intro {
		max-width: 42rem;
		margin: 0.35rem 0 1.25rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}

	@media print {
		.seo-intro {
			display: none;
		}
	}
</style>
