---
import SuktaPage from './SuktaPage.astro';
import BrahmanaVerses from './BrahmanaVerses.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import SamhitaPageNav from './SamhitaPageNav.astro';
import type { HomeLocale } from '../../data/home';
import {
	getTaittiriyaAranyakaPrashnaJumpItems,
	getTaittiriyaAranyakaPrashnaPageNav,
} from '../../lib/samhita-nav';
import { getTaittiriyaAranyakaPrashna } from '../../lib/taittiriya-aranyaka-corpus';
import { buildTaittiriyaAranyakaAnuvakaBlocks } from '../../lib/taittiriya-aranyaka-prose';
import { getPrashnaDisplayLabel } from '../../../scripts/lib/taittiriya-aranyaka-structure.mjs';

interface Props {
	prashna: number;
	locale?: HomeLocale;
}

const { prashna, locale = 'root' } = Astro.props;

const entry = getTaittiriyaAranyakaPrashna(prashna);
if (!entry) {
	throw new Error(`Taittirīya āraṇyakam: praśna ${prashna} not found`);
}

const blockLabel = getPrashnaDisplayLabel(prashna, locale);
const jumpItems = getTaittiriyaAranyakaPrashnaJumpItems(entry.anuvakas.length);
const pageNav = getTaittiriyaAranyakaPrashnaPageNav(prashna, locale);
const jumpTitle = locale === 'iast' ? 'Jump to anuvāka' : 'अनुवाकम् अनुगच्छ';
const sections = buildTaittiriyaAranyakaAnuvakaBlocks(entry.anuvakas, locale);
---

<SuktaPage {locale} class="rigveda-samhita veda-corpus brahmana-corpus">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} minItems={2} />
	<header class="veda-sukta-block__header veda-sukta-block__header--single">
		<span class="veda-sukta-block__label">{blockLabel}</span>
	</header>
	{
		sections.map((section) => (
			<section class="veda-sukta-block brahmana-khanda" id={`anuvaka-${section.anuvaka}`}>
				<p class="brahmana-khanda__label">
					{locale === 'iast' ? `Anuvāka ${section.anuvaka}` : `अनुवाक ${section.anuvaka}`}
				</p>
				<BrahmanaVerses verses={section.verses} />
			</section>
		))
	}
	<SamhitaPageNav links={pageNav} {locale} />
</SuktaPage>

<style>
	.brahmana-khanda {
		margin-bottom: 1.75rem;
	}

	.brahmana-khanda__label {
		margin: 0 0 0.65rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
</style>
