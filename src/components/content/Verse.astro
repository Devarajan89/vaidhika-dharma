---
import type { HomeLocale } from '../../data/home';

interface Props {
	number?: string | number;
	id?: string;
	locale?: HomeLocale;
}

const { number, id, locale = 'root' } = Astro.props;
const verseId = id ?? (number !== undefined ? `verse-${number}` : undefined);
const isIast = locale === 'iast' || locale === 'ta';
const verseLabel =
	number !== undefined
		? isIast
			? `Verse ${number}`
			: `श्लोक ${number}`
		: undefined;
---

<div class="sukta-verse" id={verseId}>
	{
		number !== undefined && (
			<span class="sukta-verse__num" aria-label={verseLabel}>
				({number})
			</span>
		)
	}
	<div class="sukta-verse__text">
		<slot />
	</div>
</div>

<style>
	.sukta-verse {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem 1rem;
		align-items: start;
		margin: 0 0 1.25em;
		padding: 0.85rem 1rem;
		border-left: 3px solid var(--sl-color-gray-5);
		border-radius: 0 0.375rem 0.375rem 0;
		background: var(--sl-color-gray-7);
		font-size: var(--sl-mantra-size, 1.25rem);
		line-height: var(--sl-mantra-line-height, 2);
	}

	:global([data-theme='light']) .sukta-verse {
		background: var(--color-gray-100);
	}

	.sukta-verse__num {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.6;
		color: var(--sl-color-accent);
		white-space: nowrap;
		padding-top: 0.2em;
	}

	.sukta-verse__text :global(p) {
		margin: 0;
		max-width: none;
	}

	.sukta-verse__text :global(p + p) {
		margin-top: 0.35em;
	}

	@media (max-width: 40rem) {
		.sukta-verse {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>
