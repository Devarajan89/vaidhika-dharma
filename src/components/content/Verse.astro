---
import type { HomeLocale } from '../../data/home';
import { getUiCopy } from '../../data/ui-copy';
import { formatMantraMarker } from '../../lib/rigveda-samhita';

interface Props {
	number?: string | number;
	id?: string;
	locale?: HomeLocale;
	numberPosition?: 'start' | 'end';
	marker?: string;
	cite?: string;
}

const { number, id, locale = 'root', numberPosition = 'end', marker: markerOverride, cite } = Astro.props;
const mantraId =
	id ?? (number !== undefined ? `verse-${number}` : undefined);
const isIast = locale === 'iast' || locale === 'ta';
const mantraLabel =
	number !== undefined
		? isIast
			? `Mantra ${number}`
			: `मन्त्र ${number}`
		: undefined;
const marker =
	markerOverride ??
	(number !== undefined ? formatMantraMarker(Number(number), locale) : undefined);
const copy = getUiCopy(locale === 'iast' ? 'iast' : 'root');
---

<div class="veda-mantra notranslate" id={mantraId} translate="no" data-cite={cite}>
	{
		number !== undefined && numberPosition === 'start' && (
			<span class="veda-mantra__num" aria-label={mantraLabel}>
				({number})
			</span>
		)
	}
	<div class="veda-mantra__text sukta-verse__text">
		<slot />
		{
			number !== undefined && numberPosition === 'end' && marker && (
				<span class="veda-mantra__marker sukta-verse__marker" aria-label={mantraLabel}>
					{' '}
					{marker}
				</span>
			)
		}
	</div>
	<div class="veda-mantra__alt">
		<slot name="alt" />
	</div>
	{
		(cite || mantraId) && (
			<button type="button" class="veda-mantra__copy" data-mantra-copy data-copied={copy.copied} aria-label={copy.copyCite} title={copy.copyCite}>
				{copy.copyCite}
			</button>
		)
	}
</div>

<script>
	if (!document.documentElement.dataset.copyCiteBound) {
		document.documentElement.dataset.copyCiteBound = 'true';
		document.addEventListener('click', async (event) => {
			const target = event.target;
			const button = target instanceof Element ? target.closest('[data-mantra-copy]') : null;
			if (!(button instanceof HTMLButtonElement)) return;
			const mantra = button.closest('.veda-mantra');
			const cite =
				(mantra instanceof HTMLElement ? mantra.dataset.cite : undefined) ||
				document.querySelector('h1')?.textContent?.trim() ||
				document.title.split('|')[0]?.trim();
			if (!cite) return;
			const hash = mantra?.id ? `#${mantra.id}` : '';
			const text = `${cite}\n${location.origin}${location.pathname}${hash}`;
			try {
				await navigator.clipboard.writeText(text);
				const original = button.textContent;
				button.textContent = button.dataset.copied ?? 'Copied';
				window.setTimeout(() => {
					button.textContent = original;
				}, 1600);
			} catch {
				/* ignore */
			}
		});
	}
</script>

<style>
	.veda-mantra {
		display: block;
		margin: 0 0 1.35rem;
		padding: 1.1rem 1.15rem 1.15rem;
		border: 1px solid var(--veda-border, var(--sl-color-gray-5));
		border-radius: 0.625rem;
		background: var(--veda-surface, var(--sl-color-gray-7));
		box-shadow: inset 3px 0 0 var(--veda-accent, var(--sl-color-accent));
		font-family: var(--font-sanskrit), var(--font-tamil), var(--font-latin);
		font-size: var(--sl-mantra-size, 1.3125rem);
		line-height: var(--sl-mantra-line-height, 1.75);
		color: var(--veda-text, var(--sl-color-gray-1));
		letter-spacing: 0.01em;
	}

	.veda-mantra__num {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.6;
		color: var(--veda-accent, var(--sl-color-accent));
		white-space: nowrap;
		padding-top: 0.2em;
	}

	.veda-mantra__marker {
		font-weight: 600;
		color: var(--veda-accent, var(--sl-color-accent));
		white-space: nowrap;
		display: inline;
	}

	.veda-mantra__text :global(p) {
		display: inline;
		margin: 0;
		max-width: none;
	}

	.veda-mantra__text :global(p:not(:last-of-type))::after {
		content: '\a';
		white-space: pre;
	}

	.veda-mantra__alt {
		display: none;
	}

	.veda-mantra__alt :global(p) {
		display: inline;
		margin: 0;
	}

	.veda-mantra__alt :global(p:not(:last-of-type))::after {
		content: '\a';
		white-space: pre;
	}

	.veda-mantra__copy {
		display: inline-block;
		margin: 0.65rem 0 0;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}

	.veda-mantra__copy:hover {
		color: var(--veda-accent, var(--sl-color-accent));
	}

	@media print {
		.veda-mantra {
			break-inside: avoid;
			box-shadow: none;
			border-color: #ccc;
		}

		.veda-mantra__copy {
			display: none;
		}
	}
</style>
