---
import type { HomeLocale } from '../../data/home';
import { formatMantraMarker } from '../../lib/rigveda-samhita';

interface Props {
	number?: string | number;
	id?: string;
	locale?: HomeLocale;
	numberPosition?: 'start' | 'end';
	marker?: string;
}

const { number, id, locale = 'root', numberPosition = 'end', marker: markerOverride } = Astro.props;
const mantraId =
	id ?? (number !== undefined ? `verse-${number}` : undefined);
const isIast = locale === 'iast' || locale === 'ta';
const mantraLabel =
	number !== undefined
		? isIast
			? `Mantra ${number}`
			: `मन्त्र ${number}`
		: undefined;
const marker =
	markerOverride ??
	(number !== undefined ? formatMantraMarker(Number(number), locale) : undefined);
---

<div class="veda-mantra" id={mantraId}>
	{
		number !== undefined && numberPosition === 'start' && (
			<span class="veda-mantra__num" aria-label={mantraLabel}>
				({number})
			</span>
		)
	}
	<div class="veda-mantra__text sukta-verse__text">
		<slot />
		{
			number !== undefined && numberPosition === 'end' && marker && (
				<span class="veda-mantra__marker sukta-verse__marker" aria-label={mantraLabel}>
					{' '}
					{marker}
				</span>
			)
		}
	</div>
</div>

<style>
	.veda-mantra {
		display: block;
		margin: 0 0 1.35rem;
		padding: 1.1rem 1.15rem 1.15rem;
		border: 1px solid var(--veda-border, var(--sl-color-gray-5));
		border-radius: 0.625rem;
		background: var(--veda-surface, var(--sl-color-gray-7));
		box-shadow: inset 3px 0 0 var(--veda-accent, var(--sl-color-accent));
		font-family: var(--font-sanskrit), var(--font-tamil), var(--font-latin);
		font-size: var(--sl-mantra-size, 1.3125rem);
		line-height: var(--sl-mantra-line-height, 1.75);
		color: var(--veda-text, var(--sl-color-gray-1));
		letter-spacing: 0.01em;
	}

	.veda-mantra__num {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.6;
		color: var(--veda-accent, var(--sl-color-accent));
		white-space: nowrap;
		padding-top: 0.2em;
	}

	.veda-mantra__marker {
		font-weight: 600;
		color: var(--veda-accent, var(--sl-color-accent));
		white-space: nowrap;
	}

	.veda-mantra__text :global(p) {
		display: inline;
		margin: 0;
		max-width: none;
	}

	.veda-mantra__text :global(p:not(:last-of-type))::after {
		content: '\a';
		white-space: pre;
	}

	.veda-mantra__marker {
		display: inline;
	}

	@media print {
		.veda-mantra {
			break-inside: avoid;
			box-shadow: none;
			border-color: #ccc;
		}
	}
</style>
