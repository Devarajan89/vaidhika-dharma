---
import SuktaPage from './SuktaPage.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import CorpusIndexTable from './CorpusIndexTable.astro';
import SamhitaPageNav from './SamhitaPageNav.astro';
import type { HomeLocale } from '../../data/home';
import { getMandalaSuktas } from '../../lib/rigveda-corpus';
import {
	getRigvedaMandalaJumpItems,
	getRigvedaMandalaPageNav,
	getRigvedaSuktaHref,
} from '../../lib/samhita-nav';
import { transliterateDevanagari } from '../../lib/rigveda-transliterate';

interface Props {
	mandala: number;
	locale?: HomeLocale;
}

const { mandala, locale = 'root' } = Astro.props;

const suktaRecords = getMandalaSuktas(mandala);
const jumpItems = getRigvedaMandalaJumpItems(mandala, locale);
const pageNav = getRigvedaMandalaPageNav(mandala, locale);
const jumpTitle = locale === 'iast' ? 'Jump to sūkta' : 'सूक्तम् अनुगच्छ';

const rows = await Promise.all(
	suktaRecords.map(async (suktaRecord) => {
		let header = suktaRecord.header;
		if (locale === 'iast') {
			header = suktaRecord.headerIast ?? (await transliterateDevanagari(header));
		}

		return {
			id: `sukta-${suktaRecord.sukta}`,
			href: getRigvedaSuktaHref(mandala, suktaRecord.sukta, locale),
			label:
				locale === 'iast' ? `Sūkta ${suktaRecord.sukta}` : `सूक्त ${suktaRecord.sukta}`,
			detail: header,
			count: suktaRecord.verseCount,
		};
	})
);
---

<SuktaPage locale={locale} class="rigveda-samhita">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} />
	<CorpusIndexTable
		{locale}
		{rows}
		labelHeader={locale === 'iast' ? 'Sūkta' : 'सूक्तम्'}
		detailHeader={locale === 'iast' ? 'Ṛṣi / Devatā' : 'ऋषिः / देवता'}
		countHeader={locale === 'iast' ? 'Mantras' : 'मन्त्राः'}
	/>
	<SamhitaPageNav links={pageNav} {locale} />
</SuktaPage>
