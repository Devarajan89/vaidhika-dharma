---
import type { HomeLocale } from '../../data/home';
import Verse from './Verse.astro';
import {
	getSamhitaVerseHref,
	getVerseRecord,
	samhitaLinkLabel,
	samhitaRefCode,
	splitMantraPadas,
	type VerseRecord,
} from '../../lib/rigveda-corpus';

interface Props {
	mandala?: number;
	sukta?: number;
	verse?: number;
	label: number;
	text?: string;
	altText?: string;
	verseRecord?: VerseRecord;
	locale?: HomeLocale;
}

const { mandala, sukta, verse, label, text, altText, verseRecord, locale = 'root' } = Astro.props;
const record =
	verseRecord ??
	(mandala !== undefined && sukta !== undefined && verse !== undefined
		? getVerseRecord(mandala, sukta, verse)
		: undefined);
const displayText = text ?? record?.text ?? '';
const resolvedAlt =
	altText ?? (locale === 'iast' ? record?.text : record?.iast);
const padas = splitMantraPadas(displayText);
const altPadas = resolvedAlt && resolvedAlt !== displayText ? splitMantraPadas(resolvedAlt) : [];
const hasSamhitaRef =
	mandala !== undefined && sukta !== undefined && verse !== undefined;
const samhitaHref = hasSamhitaRef
	? getSamhitaVerseHref(mandala!, sukta!, verse!, locale)
	: undefined;
const samhitaRef = hasSamhitaRef
	? samhitaRefCode(mandala!, sukta!, verse!)
	: undefined;
const samhitaAriaLabel = hasSamhitaRef
	? samhitaLinkLabel(mandala!, sukta!, verse!, locale)
	: undefined;
const lastPadaIndex = padas.length - 1;
---

<Verse id={`verse-${label}`} number={hasSamhitaRef ? undefined : label} locale={locale} numberPosition="end">
	{
		padas.map((pada, index) => (
			<p>
				{pada}
				{
					index === lastPadaIndex && samhitaHref && samhitaRef && (
						<span class="rigveda-mantra__ref-marker" aria-label={samhitaAriaLabel}>
							{' '}
							॥<a href={samhitaHref}>{samhitaRef}</a>॥
						</span>
					)
				}
			</p>
		))
	}
	{altPadas.length > 0 && (
		<div class="veda-mantra__alt" slot="alt">
			{altPadas.map((pada) => (
				<p>{pada}</p>
			))}
		</div>
	)}
</Verse>
