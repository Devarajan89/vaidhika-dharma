---
import SuktaPage from './SuktaPage.astro';
import Verse from './Verse.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import SamhitaPageNav from './SamhitaPageNav.astro';
import type { HomeLocale } from '../../data/home';
import { splitMantraPadas } from '../../lib/rigveda-samhita';
import { formatAnuvakaMarker } from '../../lib/yajurveda-samhita';
import { transliterateDevanagari } from '../../lib/rigveda-transliterate';
import {
	getMaitrayaniKandaJumpItems,
	getMaitrayaniKandaPageNav,
	getMaitrayaniPrapathakaHref,
} from '../../lib/samhita-nav';
import { getMaitrayaniKandaChapters } from '../../lib/maitrayani-corpus';
import { parseMaitrayaniPrapathaka } from '../../../scripts/lib/parse-maitrayani-prapathaka.mjs';
import { MAITRAYANI_KANDAS } from '../../../scripts/lib/maitrayani-samhita-structure.mjs';

interface Props {
	kanda: number;
	locale?: HomeLocale;
}

const { kanda, locale = 'root' } = Astro.props;

const kandaInfo = MAITRAYANI_KANDAS.find((entry) => entry.kanda === kanda);
if (!kandaInfo) {
	throw new Error(`Maitrāyaṇī saṃhitā: kāṇḍa ${kanda} not found`);
}

const chapters = getMaitrayaniKandaChapters(kanda);
const jumpItems = getMaitrayaniKandaJumpItems(kanda, locale);
const pageNav = getMaitrayaniKandaPageNav(kanda, locale);
const jumpTitle = locale === 'iast' ? 'Jump to prapāṭhaka' : 'प्रपाठकम् अनुगच्छ';

const sections = await Promise.all(
	chapters.map(async (entry) => {
		const parsed = parseMaitrayaniPrapathaka(entry.text, {
			kanda: entry.kanda,
			prapathaka: entry.prapathaka,
		});

		let header = parsed.header;
		if (locale === 'iast' && header) {
			header = await transliterateDevanagari(header);
		}

		const verses = await Promise.all(
			parsed.verses.map(async (verse) => ({
				number: verse.number,
				text: locale === 'iast' ? await transliterateDevanagari(verse.text) : verse.text,
			}))
		);

		return {
			kanda: entry.kanda,
			prapathaka: entry.prapathaka,
			header,
			verses,
		};
	})
);
---

<SuktaPage {locale} class="rigveda-samhita">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} />
	{
		sections.map((section) => (
			<section class="veda-sukta-block" id={`prapathaka-${section.prapathaka}`}>
				<header class="veda-sukta-block__header">
					<a
						class="veda-sukta-block__label veda-sukta-block__label--link"
						href={getMaitrayaniPrapathakaHref(kanda, section.prapathaka, locale)}
					>
						{locale === 'iast'
							? `Prapāṭhaka ${section.prapathaka}`
							: `प्रपाठक ${section.prapathaka}`}
					</a>
					{section.header && <p class="veda-sukta-block__title">{section.header}</p>}
				</header>
				<div class="veda-sukta-block__mantras">
					{section.verses.map((verse) => (
						<Verse
							number={verse.number}
							id={`prapathaka-${section.prapathaka}-anuvaka-${verse.number}`}
							{locale}
							numberPosition="end"
							marker={formatAnuvakaMarker(
								section.kanda,
								section.prapathaka,
								verse.number,
								locale
							)}
						>
							{splitMantraPadas(verse.text).map((pada) => (
								<p>{pada}</p>
							))}
						</Verse>
					))}
				</div>
			</section>
		))
	}
	<SamhitaPageNav links={pageNav} {locale} />
</SuktaPage>
