---
import type { HomeLocale } from '../../data/home';
import type { SamhitaPageNavLinks } from '../../lib/samhita-nav';

interface Props {
	links: SamhitaPageNavLinks;
	locale?: HomeLocale;
}

const { links, locale = 'root' } = Astro.props;
const { prev, next, up, index, start, progress } = links;

if (!prev && !next && !up && !index && !start) {
	return null;
}

const isIast = locale === 'iast';
const prevDir = isIast ? 'Previous' : 'पूर्व';
const nextDir = isIast ? 'Next' : 'अग्रिम';
const seqLabel = isIast ? 'Sequence' : 'क्रमः';
const shortcutHint = isIast ? 'n / p' : 'n / p';
---

<nav class="samhita-page-nav" aria-label={isIast ? 'Saṃhitā navigation' : 'संहिता नेविगेशन'}>
	{
		start && (
			<p class="samhita-page-nav__start">
				<a class="samhita-page-nav__start-link" href={start.href}>
					{start.label}
				</a>
			</p>
		)
	}
	<div class="samhita-page-nav__secondary">
		{
			up && (
				<a class="samhita-page-nav__link samhita-page-nav__link--up" href={up.href}>
					{up.label}
				</a>
			)
		}
		{
			index && (
				<a class="samhita-page-nav__link samhita-page-nav__link--index" href={index.href}>
					{index.label}
				</a>
			)
		}
	</div>
	<div class="samhita-page-nav__row">
		{
			prev ? (
				<a class="samhita-page-nav__link samhita-page-nav__link--prev" href={prev.href} data-seq="prev">
					<span class="samhita-page-nav__dir">{prevDir}</span>
					<span class="samhita-page-nav__label">{prev.label}</span>
				</a>
			) : (
				<span />
			)
		}
		{
			next ? (
				<a class="samhita-page-nav__link samhita-page-nav__link--next" href={next.href} data-seq="next">
					<span class="samhita-page-nav__dir">{nextDir}</span>
					<span class="samhita-page-nav__label">{next.label}</span>
				</a>
			) : (
				<span />
			)
		}
	</div>
</nav>

{
	(prev || next || progress) && (
		<nav class="corpus-seq-bar" aria-label={seqLabel} data-corpus-seq>
			{prev ? (
				<a class="corpus-seq-bar__btn" href={prev.href} data-seq="prev" aria-label={`${prevDir}: ${prev.label}`}>
					← {prevDir}
				</a>
			) : (
				<span class="corpus-seq-bar__btn is-disabled" aria-hidden="true">
					← {prevDir}
				</span>
			)}
			<span class="corpus-seq-bar__progress">
				{progress
					? `${progress.context} · ${progress.current} / ${progress.total}`
					: shortcutHint}
			</span>
			{next ? (
				<a class="corpus-seq-bar__btn corpus-seq-bar__btn--next" href={next.href} data-seq="next" aria-label={`${nextDir}: ${next.label}`}>
					{nextDir} →
				</a>
			) : (
				<span class="corpus-seq-bar__btn is-disabled" aria-hidden="true">
					{nextDir} →
				</span>
			)}
		</nav>
	)
}

<script>
	let sequenceAbort: AbortController | undefined;

	function bindCorpusSequence() {
		sequenceAbort?.abort();
		sequenceAbort = new AbortController();
		const { signal } = sequenceAbort;

		const go = (direction: 'prev' | 'next') => {
			const link = document.querySelector<HTMLAnchorElement>(`a[data-seq="${direction}"]`);
			if (!link) return;
			window.location.assign(link.pathname);
		};

		document.querySelectorAll<HTMLAnchorElement>('a[data-seq]').forEach((link) => {
			link.addEventListener(
				'click',
				(event) => {
					event.preventDefault();
					window.location.assign(link.pathname);
				},
				{ signal }
			);
		});

		window.addEventListener(
			'keydown',
			(event: KeyboardEvent) => {
				if (event.metaKey || event.ctrlKey || event.altKey) return;
				const target = event.target;
				if (
					target instanceof HTMLElement &&
					(target.closest('input, textarea, select, [contenteditable="true"]') ||
						target.isContentEditable)
				) {
					return;
				}
				if (event.key === 'n' || event.key === 'j') {
					event.preventDefault();
					go('next');
				} else if (event.key === 'p' || event.key === 'k') {
					event.preventDefault();
					go('prev');
				}
			},
			{ signal }
		);
	}

	bindCorpusSequence();
	document.addEventListener('astro:page-load', bindCorpusSequence);
</script>

<style>
	.samhita-page-nav {
		margin: 2rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-gray-5);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.samhita-page-nav__start {
		margin: 0;
	}

	.samhita-page-nav__start-link {
		display: inline-flex;
		padding: 0.55rem 0.95rem;
		border-radius: 0.5rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-white);
		text-decoration: none;
		font-weight: 600;
	}

	.samhita-page-nav__secondary {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.samhita-page-nav__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}

	.samhita-page-nav__link {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.65rem 0.85rem;
		text-decoration: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7);
		color: var(--sl-color-gray-2);
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease;
	}

	:global([data-theme='light']) .samhita-page-nav__link {
		background: var(--color-gray-100);
		border-color: var(--color-gray-300);
		color: var(--color-gray-800);
	}

	.samhita-page-nav__link:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent);
	}

	.samhita-page-nav__link--next {
		text-align: right;
		align-items: flex-end;
	}

	.samhita-page-nav__link--up,
	.samhita-page-nav__link--index {
		flex-direction: row;
		align-items: center;
		font-size: 0.875rem;
	}

	.samhita-page-nav__dir {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}

	.samhita-page-nav__label {
		font-size: 0.9375rem;
		font-weight: 400;
	}

	.corpus-seq-bar {
		position: fixed;
		left: 50%;
		bottom: calc(0.85rem + var(--reader-bar-height, 3.25rem) + env(safe-area-inset-bottom, 0px));
		transform: translateX(-50%);
		z-index: 39;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.45rem;
		width: max-content;
		max-width: calc(100vw - 1.5rem);
		background: color-mix(in srgb, var(--sl-color-bg) 90%, var(--sl-color-gray-6));
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		box-shadow: 0 8px 24px color-mix(in srgb, var(--sl-color-black) 16%, transparent);
		backdrop-filter: blur(10px);
	}

	.corpus-seq-bar__btn {
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}

	.corpus-seq-bar__btn:hover {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
	}

	.corpus-seq-bar__btn.is-disabled {
		opacity: 0.35;
	}

	.corpus-seq-bar__progress {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sl-color-gray-3);
		padding: 0 0.35rem;
		white-space: nowrap;
		max-width: 14rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (max-width: 40rem) {
		.samhita-page-nav__row {
			grid-template-columns: 1fr;
		}

		.samhita-page-nav__link--next {
			text-align: left;
			align-items: flex-start;
		}
	}

	@media print {
		.samhita-page-nav,
		.corpus-seq-bar {
			display: none;
		}
	}
</style>
