---
import SuktaPage from './SuktaPage.astro';
import BrahmanaProse from './BrahmanaProse.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import SamhitaPageNav from './SamhitaPageNav.astro';
import type { HomeLocale } from '../../data/home';
import {
	getAitareyaAdhyayaHref,
	getAitareyaPanchikaJumpItems,
	getAitareyaPanchikaPageNav,
} from '../../lib/samhita-nav';
import { getAitareyaPanchikaAdhyayas } from '../../lib/aitareya-corpus';
import { buildAitareyaKhandaBlocks } from '../../lib/aitareya-prose';
import { AITAREYA_PANCHIKAS } from '../../../scripts/lib/aitareya-brahmana-structure.mjs';

interface Props {
	panchika: number;
	locale?: HomeLocale;
}

const { panchika, locale = 'root' } = Astro.props;

const panchikaInfo = AITAREYA_PANCHIKAS.find((entry) => entry.panchika === panchika);
if (!panchikaInfo) {
	throw new Error(`Aitareya brāhmaṇam: pañcikā ${panchika} not found`);
}

const adhyayas = getAitareyaPanchikaAdhyayas(panchika);
const jumpItems = getAitareyaPanchikaJumpItems(panchika, locale);
const pageNav = getAitareyaPanchikaPageNav(panchika, locale);
const jumpTitle = locale === 'iast' ? 'Jump to adhyāya' : 'अध्यायम् अनुगच्छ';

const sections = adhyayas.map((entry) => ({
	adhyaya: entry.adhyaya,
	globalAdhyaya: entry.globalAdhyaya,
	khandas: buildAitareyaKhandaBlocks(entry.khandas, locale),
}));
---

<SuktaPage {locale} class="rigveda-samhita veda-corpus brahmana-corpus">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} />
	{
		sections.map((section) => (
			<section class="veda-sukta-block" id={`adhyaya-${section.adhyaya}`}>
				<header class="veda-sukta-block__header">
					<a
						class="veda-sukta-block__label veda-sukta-block__label--link"
						href={getAitareyaAdhyayaHref(panchika, section.adhyaya, locale)}
					>
						{locale === 'iast' ? `Adhyāya ${section.adhyaya}` : `अध्याय ${section.adhyaya}`}
					</a>
				</header>
				{section.khandas.map((khanda) => (
					<div class="brahmana-khanda">
						<p class="brahmana-khanda__label">
							{locale === 'iast' ? `Khaṇḍa ${khanda.khanda}` : `खण्ड ${khanda.khanda}`}
						</p>
						<BrahmanaProse text={khanda.prose} />
					</div>
				))}
			</section>
		))
	}
	<SamhitaPageNav links={pageNav} {locale} />
</SuktaPage>

<style>
	.brahmana-khanda {
		margin-bottom: 1.75rem;
	}

	.brahmana-khanda__label {
		margin: 0 0 0.65rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
</style>
