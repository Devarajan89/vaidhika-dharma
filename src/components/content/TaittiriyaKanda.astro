---
import SuktaPage from './SuktaPage.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import CorpusIndexTable from './CorpusIndexTable.astro';
import SamhitaPageNav from './SamhitaPageNav.astro';
import type { HomeLocale } from '../../data/home';
import { transliterateDevanagari } from '../../lib/rigveda-transliterate';
import {
	getTaittiriyaKandaJumpItems,
	getTaittiriyaKandaPageNav,
	getTaittiriyaPrapathakaHref,
} from '../../lib/samhita-nav';
import { getTaittiriyaKandaChapters } from '../../lib/taittiriya-corpus';
import { parseTaittiriyaPrapathaka } from '../../../scripts/lib/parse-taittiriya-prapathaka.mjs';
import { TAITTIRIYA_KANDAS } from '../../../scripts/lib/taittiriya-samhita-structure.mjs';

interface Props {
	kanda: number;
	locale?: HomeLocale;
}

const { kanda, locale = 'root' } = Astro.props;

const kandaInfo = TAITTIRIYA_KANDAS.find((entry) => entry.kanda === kanda);
if (!kandaInfo) {
	throw new Error(`Taittirīya saṃhitā: kāṇḍa ${kanda} not found`);
}

const chapters = getTaittiriyaKandaChapters(kanda);
const jumpItems = getTaittiriyaKandaJumpItems(kanda, locale);
const pageNav = getTaittiriyaKandaPageNav(kanda, locale);
const jumpTitle = locale === 'iast' ? 'Jump to prapāṭhaka' : 'प्रपाठकम् अनुगच्छ';

const rows = await Promise.all(
	chapters.map(async (entry) => {
		const parsed = parseTaittiriyaPrapathaka(entry.text, {
			kanda: entry.kanda,
			prapathaka: entry.prapathaka,
		});

		let detail = parsed.firstWord || parsed.header;
		if (locale === 'iast' && detail) {
			detail = await transliterateDevanagari(detail);
		}

		return {
			id: `prapathaka-${entry.prapathaka}`,
			href: getTaittiriyaPrapathakaHref(kanda, entry.prapathaka, locale),
			label:
				locale === 'iast'
					? `Prapāṭhaka ${entry.prapathaka}`
					: `प्रपाठक ${entry.prapathaka}`,
			detail,
			count: parsed.verseCount,
		};
	})
);
---

<SuktaPage {locale} class="rigveda-samhita">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} />
	<CorpusIndexTable
		{locale}
		{rows}
		labelHeader={locale === 'iast' ? 'Prapāṭhaka' : 'प्रपाठकः'}
		detailHeader={locale === 'iast' ? 'Opening' : 'आदिः'}
		countHeader={locale === 'iast' ? 'Anuvākas' : 'अनुवाकाः'}
	/>
	<SamhitaPageNav links={pageNav} {locale} />
</SuktaPage>
