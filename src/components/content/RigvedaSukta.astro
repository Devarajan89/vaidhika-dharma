---
import SuktaPage from './SuktaPage.astro';
import Verse from './Verse.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import SamhitaPageNav from './SamhitaPageNav.astro';
import type { HomeLocale } from '../../data/home';
import { getSuktaRecord, getSuktaVerses } from '../../lib/rigveda-corpus';
import {
	getRigvedaSuktaMantraJumpItems,
	getRigvedaSuktaPageNav,
} from '../../lib/samhita-nav';
import { splitMantraPadas } from '../../lib/rigveda-samhita';
import { transliterateDevanagari } from '../../lib/rigveda-transliterate';

interface Props {
	mandala: number;
	sukta: number;
	locale?: HomeLocale;
}

const { mandala, sukta, locale = 'root' } = Astro.props;

const suktaRecord = getSuktaRecord(mandala, sukta);
if (!suktaRecord) {
	throw new Error(`Ṛgveda saṃhitā: mandala ${mandala}, sukta ${sukta} not found`);
}

let header = suktaRecord.header;
const mantraRecords = getSuktaVerses(mandala, sukta);
const jumpItems = getRigvedaSuktaMantraJumpItems(mandala, sukta, locale);
const pageNav = getRigvedaSuktaPageNav(mandala, sukta, locale);
const jumpTitle = locale === 'iast' ? 'Jump to mantra' : 'मन्त्रम् अनुगच्छ';

/** @type {Record<number, string>} */
const mantraTexts = {};

for (const record of mantraRecords) {
	if (locale === 'iast') {
		mantraTexts[record.verse] = record.iast ?? (await transliterateDevanagari(record.text));
	} else {
		mantraTexts[record.verse] = record.text;
	}
}

if (locale === 'iast') {
	header = suktaRecord.headerIast ?? (await transliterateDevanagari(header));
}
---

<SuktaPage locale={locale} class="rigveda-samhita">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} minItems={2} />
	<header class="veda-sukta-block__header veda-sukta-block__header--single">
		<span class="veda-sukta-block__label">
			{locale === 'iast' ? `Sūkta ${sukta}` : `सूक्त ${sukta}`}
		</span>
		{header && <p class="veda-sukta-block__title">{header}</p>}
	</header>
	<div class="veda-sukta-block__mantras">
		{
			mantraRecords.map((record) => (
				<Verse
					number={record.verse}
					id={`mantra-${record.verse}`}
					locale={locale}
					numberPosition="end"
				>
					{splitMantraPadas(mantraTexts[record.verse]).map((pada) => (
						<p>{pada}</p>
					))}
				</Verse>
			))
		}
	</div>
	<SamhitaPageNav links={pageNav} {locale} />
</SuktaPage>
