---
import SuktaPage from './SuktaPage.astro';
import Verse from './Verse.astro';
import MantraPadas from './MantraPadas.astro';
import CorpusJumpNav from './CorpusJumpNav.astro';
import type { HomeLocale } from '../../data/home';
import { splitMantraPadas } from '../../lib/rigveda-samhita';
import { formatMantraMarker } from '../../lib/rigveda-samhita';
import { transliterateDevanagariMany } from '../../lib/rigveda-transliterate';
import {
	getUpanishadCorpus,
	getUpanishadMantraJumpItems,
	upanishadCite,
	type UpanishadId,
} from '../../lib/upanishad-corpus';

interface Props {
	id: UpanishadId;
	locale?: HomeLocale;
	blockLabel?: string;
}

const { id, locale = 'root', blockLabel: blockLabelOverride } = Astro.props;
const corpus = getUpanishadCorpus(id);
const blockLabel = blockLabelOverride ?? corpus.title ?? id;
const jumpTitle = locale === 'iast' ? 'Jump to mantra' : 'मन्त्रम् अनुगच्छ';
const jumpItems = getUpanishadMantraJumpItems(corpus.sections);

const iastMeta =
	locale === 'iast'
		? await transliterateDevanagariMany([
				corpus.openingShanti ?? '',
				...corpus.sections.map((section) => section.label),
			])
		: [];

const missingVerseIast =
	locale === 'iast'
		? await transliterateDevanagariMany(
				corpus.sections.flatMap((section) =>
					section.verses.filter((verse) => !verse.textIast).map((verse) => verse.text)
				)
			)
		: [];

let iastIndex = 0;
let missingIndex = 0;
const openingShanti = locale === 'iast' ? iastMeta[iastIndex++] || null : corpus.openingShanti;
const openingPadas = openingShanti ? splitMantraPadas(openingShanti) : [];

const sections = corpus.sections.map((section) => {
	const label = locale === 'iast' ? iastMeta[iastIndex++] : section.label;
	const verses = section.verses.map((verse) => {
		const text =
			locale === 'iast' ? (verse.textIast ?? missingVerseIast[missingIndex++]) : verse.text;
		const alt = locale === 'iast' ? verse.text : (verse.textIast ?? undefined);
		return {
			number: verse.number,
			cite: upanishadCite(id, section.type, verse.number),
			marker: formatMantraMarker(verse.number, locale),
			padas: splitMantraPadas(text),
			altPadas: alt ? splitMantraPadas(alt) : [],
		};
	});
	return { type: section.type, label, verses };
});
---

<SuktaPage {locale} class="rigveda-samhita veda-corpus">
	<CorpusJumpNav items={jumpItems} {locale} title={jumpTitle} minItems={6} />
	<header class="veda-sukta-block__header veda-sukta-block__header--single">
		<span class="veda-sukta-block__label">{blockLabel}</span>
	</header>
	{
		openingPadas.length > 0 && (
			<section class="upanishad-shanti">
				<MantraPadas padas={openingPadas} />
			</section>
		)
	}
	{
		sections.map((section, sectionIndex) => (
			<section
				class="veda-sukta-block upanishad-section"
				id={section.type || undefined}
			>
				<p class="upanishad-section__label">{section.label}</p>
				<div class="veda-sukta-block__mantras">
					{section.verses.map((verse) => (
						<Verse
							number={verse.number}
							id={'mantra-' + (sectionIndex + 1) + '-' + verse.number}
							locale={locale}
							numberPosition="end"
							marker={verse.marker}
							cite={verse.cite}
						>
							<MantraPadas padas={verse.padas} />
							<div slot="alt">
								<MantraPadas padas={verse.altPadas} />
							</div>
						</Verse>
					))}
				</div>
			</section>
		))
	}
</SuktaPage>

<style>
	.upanishad-shanti {
		margin: 0 0 2rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		font-family: var(--font-sanskrit), serif;
		line-height: var(--sl-mantra-line-height);
	}

	.upanishad-section + .upanishad-section {
		margin-top: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}

	.upanishad-section__label {
		margin: 0 0 1.25rem;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--sl-color-gray-3);
	}
</style>
