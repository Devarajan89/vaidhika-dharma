---
import type { HomeLocale } from '../../data/home';
import type { RitualVariant, SandhyaTime } from './sandhya-types';
import { toLocaleKey } from './sandhya-types';
import { getPrayascittaBody } from './prayascitta-arghyam-data';
import './ritual-styles.css';

interface Props {
	locale?: HomeLocale;
	variant: RitualVariant;
	time?: SandhyaTime;
}

const { locale = 'root', variant, time = 'prata' } = Astro.props;
const localeKey = toLocaleKey(locale);
const body = getPrayascittaBody(localeKey, variant, time);

const title = localeKey === 'root' ? 'प्रायश्चित्त अर्घ्यं' : 'Prāyaścitta arghyaṃ';

function renderBlocks(text: string) {
	return text.split(/\n\n+/).map((block) => block.trim()).filter(Boolean);
}

const blocks = renderBlocks(body);
---

<div class="ritual-step prayascitta-arghyam">
	<h5>{title}</h5>

	{blocks.map((block) => {
		if (block.startsWith('>')) {
			return (
				<blockquote>
					<p>{block.replace(/^>\s?/, '')}</p>
				</blockquote>
			);
		}
		if (block.startsWith('**')) {
			return <p class="ritual-meta" set:html={block} />;
		}
		if (block.startsWith('*')) {
			return (
				<p>
					<em>{block.replace(/^\*|\*$/g, '')}</em>
				</p>
			);
		}
		return <p>{block}</p>;
	})}
</div>
