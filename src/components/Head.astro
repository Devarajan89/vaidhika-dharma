---
import Default from '@astrojs/starlight/components/Head.astro';
import { buildPageJsonLd, getSeriesName, getSeriesTitle } from '../lib/structured-data';
import {
	buildDocumentTitle,
	buildSeoDescription,
	isIastSlug,
	ogImageUrl,
	slugPath,
} from '../lib/seo';

const { entry, lastUpdated } = Astro.locals.starlightRoute;
const site = Astro.site ?? new URL('https://vaidhikadharma.org');
const slug = String(entry.data.slug ?? entry.id);
const path = slugPath(slug);
const canonicalUrl = new URL(path === '' ? '/' : `/${path}/`.replace(/\/+/g, '/'), site).href;
const isIast = isIastSlug(slug, Astro.locals.starlightRoute.locale);
const title = buildDocumentTitle(entry.data.title, slug, getSeriesTitle(slug, isIast));
const description = buildSeoDescription(
	title,
	entry.data.description,
	slug,
	isIast,
	getSeriesName(slug)
);
const inLanguage = isIast ? 'sa-Latn' : 'sa-Deva';
const image = ogImageUrl(site.href);

const jsonLd = buildPageJsonLd({
	title,
	description,
	canonicalUrl,
	siteUrl: site.href,
	inLanguage,
	slug,
	dateModified: lastUpdated?.toISOString(),
});
---

<Default {...Astro.props} />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#cb0003" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Vaidhika Dharma" />
<link rel="apple-touch-icon" href="/images/favicon.svg" />
<link rel="image_src" href={image} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script async src="https://www.googletagmanager.com/gtag/js?id=G-FLFCLRJNG3" is:inline></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	gtag('js', new Date());
	gtag('config', 'G-FLFCLRJNG3');
</script>
<script is:inline>
	if ('serviceWorker' in navigator) {
		window.addEventListener('load', () => {
			navigator.serviceWorker.register('/sw.js').catch(() => {});
		});
	}
</script>
