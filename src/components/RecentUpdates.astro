---
import { Card } from '@astrojs/starlight/components';
import type { HomeLocale } from '../data/home';
import { homeContent } from '../data/home';
import docCache from '../data/doc-cache.json';

interface Props {
	locale: HomeLocale;
	limit?: number;
}

const { locale, limit = 5 } = Astro.props;
const { recentTitle } = homeContent;

function getPageUrl(slug: string | undefined, id: string): string {
	const path = slug ?? id;
	return `/${path}/`;
}

function formatDate(dateStr: string): string {
	return new Date(dateStr).toLocaleDateString('en-IN', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}

const recent = (docCache.recentByLocale[locale] ?? []).slice(0, limit);
---

<div class="recent-updates home-card">
	<Card title={recentTitle} icon="calendar">
		{
			recent.length > 0 ? (
				<ul class="recent-updates__list">
					{recent.map((entry) => (
						<li>
							<a href={getPageUrl(entry.slug, entry.id)}>
								<span class="recent-updates__title">{entry.title}</span>
								<time datetime={entry.lastUpdated}>{formatDate(entry.lastUpdated)}</time>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="recent-updates__empty">No updates yet.</p>
			)
		}
	</Card>
</div>

<style>
	.recent-updates__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.recent-updates__list li {
		border-bottom: 1px solid var(--sl-color-gray-5);
		padding: 0.5rem 0;
	}

	.recent-updates__list li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.recent-updates__list a {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		text-decoration: none;
		color: inherit;
		transition: color 0.2s ease;
	}

	.recent-updates__list a:hover {
		color: var(--sl-color-accent);
	}

	.recent-updates__title {
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.recent-updates__list time {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}

	.recent-updates__empty {
		margin: 0;
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
	}
</style>
