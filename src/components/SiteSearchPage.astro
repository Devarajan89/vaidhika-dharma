---
import { featuredSearchHits, groupSearchHits, searchSitePages, type SiteSearchHit } from '../lib/site-search';
import { resolveHomeLocale } from '../data/home';
import { getSeoIntro } from '../data/seo-page-copy';
import { SEARCH_SYNONYMS } from '../data/search-synonyms';

const locale = resolveHomeLocale(Astro.locals.starlightRoute.locale);
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const synonymTitles = Object.fromEntries(
	SEARCH_SYNONYMS.flatMap((entry) => [
		[entry.href.root.replace(/^\/|\/$/g, ''), entry.label.root],
		[entry.href.iast.replace(/^\/|\/$/g, ''), entry.label.iast],
	])
);
const hits: SiteSearchHit[] = query
	? searchSitePages(query, locale, synonymTitles)
	: featuredSearchHits(locale);
const groups = groupSearchHits(hits, locale);
const intro = getSeoIntro(locale === 'iast' ? 'iast/search' : 'search', locale);
const headingEmpty = locale === 'iast' ? 'Popular pages' : 'प्रमुख पृष्ठाः';
const headingQueryPrefix = locale === 'iast' ? 'Results for' : 'अन्वेषणम्';
const empty =
	locale === 'iast'
		? 'No matching pages. Try rudram, RV 10.90.1, TS 1.1.1, or puruṣa.'
		: 'न प्राप्तम् । rudram, RV 10.90.1, TS 1.1.1, puruṣa इति प्रयतस्व ।';
const searchAction = locale === 'iast' ? '/iast/search/' : '/search/';
const placeholder = locale === 'iast' ? 'Search mantras, RV 10.90.1, TS 1.1.1' : 'मन्त्रान्, RV 10.90.1, TS 1.1.1 च अन्विष्यताम्';
const submitLabel = locale === 'iast' ? 'Search' : 'अन्विष्यताम्';
---

<section class="site-search-page" data-locale={locale} data-search-action={searchAction}>
	{intro && <p class="site-search-page__intro">{intro}</p>}
	<form class="site-search-page__form" method="get" action={searchAction}>
		<label class="sr-only" for="site-search-q">{placeholder}</label>
		<input id="site-search-q" type="search" name="q" value={query} placeholder={placeholder} />
		<button type="submit">{submitLabel}</button>
	</form>
	<h2 data-search-heading>{query ? `${headingQueryPrefix} “${query}”` : headingEmpty}</h2>
	<div data-search-hits>
		{
			groups.map((group) => (
				<section class="site-search-page__group">
					<h3>{group.label}</h3>
					<ul>
						{group.hits.map((hit) => (
							<li>
								<a href={hit.href}>{hit.title}</a>
								{hit.detail && <span> — {hit.detail}</span>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
	<p data-search-empty hidden={hits.length > 0}>{empty}</p>
</section>

<script>
	import { featuredSearchHits, groupSearchHits, searchSitePages } from '../lib/site-search';
	import type { HomeLocale } from '../data/home';

	const root = document.querySelector<HTMLElement>('.site-search-page');
	if (root) {
		const locale = (root.dataset.locale === 'iast' ? 'iast' : 'root') as HomeLocale;
		const heading = root.querySelector('[data-search-heading]');
		const list = root.querySelector('[data-search-hits]');
		const emptyEl = root.querySelector('[data-search-empty]');
		const input = root.querySelector<HTMLInputElement>('#site-search-q');
		const headingEmpty = locale === 'iast' ? 'Popular pages' : 'प्रमुख पृष्ठाः';
		const headingQueryPrefix = locale === 'iast' ? 'Results for' : 'अन्वेषणम्';

		let slugToTitle: Record<string, string> = {};
		const indexReady = fetch('/search-index.json')
			.then((response) => (response.ok ? response.json() : []))
			.then((rows: Array<[string, string]>) => {
				slugToTitle = Object.fromEntries(rows);
			})
			.catch(() => {});

		const escapeHtml = (value: string) =>
			value
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/"/g, '&quot;');

		const render = (query: string) => {
			const hits = query
				? searchSitePages(query, locale, slugToTitle)
				: featuredSearchHits(locale);
			const groups = groupSearchHits(hits, locale);
			if (heading) {
				heading.textContent = query ? `${headingQueryPrefix} “${query}”` : headingEmpty;
			}
			if (list) {
				list.innerHTML = groups
					.map(
						(group) =>
							`<section class="site-search-page__group"><h3>${escapeHtml(group.label)}</h3><ul>${group.hits
								.map(
									(hit) =>
										`<li><a href="${escapeHtml(hit.href)}">${escapeHtml(hit.title)}</a>${hit.detail ? ` <span> — ${escapeHtml(hit.detail)}</span>` : ''}</li>`
								)
								.join('')}</ul></section>`
					)
					.join('');
			}
			if (emptyEl instanceof HTMLElement) emptyEl.hidden = hits.length > 0;
		};

		const applyUrlQuery = async () => {
			const query = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';
			if (input && query) input.value = query;
			if (query) await indexReady;
			render(query);
		};

		void applyUrlQuery();
		window.addEventListener('popstate', () => void applyUrlQuery());
	}
</script>

<style>
	.site-search-page {
		max-width: 42rem;
	}

	.site-search-page__intro {
		margin: 0 0 1rem;
		color: var(--sl-color-gray-2);
	}

	.site-search-page__form {
		display: flex;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
	}

	.site-search-page__form input {
		flex: 1;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: var(--sl-color-gray-7);
		color: var(--sl-color-white);
	}

	.site-search-page__form button {
		padding: 0.55rem 0.9rem;
		border: 0;
		border-radius: 0.375rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-white);
		cursor: pointer;
	}

	.site-search-page__group h3 {
		margin: 1.25rem 0 0.4rem;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	.site-search-page ul {
		padding-left: 1.2rem;
	}

	.site-search-page li {
		margin: 0.4rem 0;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}
</style>
