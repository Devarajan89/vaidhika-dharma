---
import { Icon } from '@astrojs/starlight/components';
import { WHATSAPP_CHANNEL_URL, YOUTUBE_CHANNEL_URL } from '../data/channels';

const links = [
	{ href: YOUTUBE_CHANNEL_URL, icon: 'youtube' as const, label: 'YouTube' },
	{ href: WHATSAPP_CHANNEL_URL, icon: 'whatsApp' as const, label: 'WhatsApp' },
];
---

{
	links.map(({ href, icon, label }) => (
		<a href={href} rel="me noopener noreferrer" target="_blank" class="sl-flex">
			<span class="sr-only">{label}</span>
			<Icon name={icon} />
		</a>
	))
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.35em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
