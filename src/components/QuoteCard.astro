---
import { Card } from '@astrojs/starlight/components';
import type { HomeLocale } from '../data/home';
import { getHomeContent, getQuoteOfDay } from '../data/home';

interface Props {
	locale: HomeLocale;
}

const { locale } = Astro.props;
const { quoteTitle } = getHomeContent(locale);
const quote = getQuoteOfDay(locale);
---

<div class="quote-card home-card">
	<Card title={quoteTitle} icon="star">
		<blockquote>
			<p>{quote.text}</p>
			<p class="quote-meaning">{quote.meaning}</p>
			<footer>— {quote.source}</footer>
		</blockquote>
	</Card>
</div>

<style>
	.quote-card blockquote {
		margin: 0;
		padding: 0;
		border: none;
		font-style: normal;
		color: var(--sl-color-gray-1);
		line-height: 1.85;
		font-size: 1.1875rem;
	}

	.quote-card blockquote p {
		margin: 0 0 0.75rem;
	}

	.quote-card .quote-meaning {
		font-size: 0.9375rem;
		color: var(--sl-color-gray-2);
		line-height: 1.65;
	}

	.quote-card footer {
		font-style: normal;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-3);
	}
</style>
