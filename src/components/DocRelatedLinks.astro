---
import { getCollection } from 'astro:content';
import { getDocRelatedLinks } from '../data/doc-related-links';

const { entry, locale } = Astro.locals.starlightRoute;
const allDocs = await getCollection('docs');

const slugToTitle = new Map<string, string>();
for (const doc of allDocs) {
	const custom = doc.data.slug;
	const slug =
		custom === 'index'
			? ''
			: custom === 'iast/index'
				? 'iast'
				: (custom ?? doc.id);
	slugToTitle.set(slug, doc.data.title);
}

const related = getDocRelatedLinks(entry, locale, slugToTitle);

if (!related || related.links.length === 0) {
	return null;
}
---

<section class="doc-related" aria-label={related.title}>
	<h2 class="doc-related__title">{related.title}</h2>
	<ul class="doc-related__list">
		{
			related.links.map((item) => (
				<li>
					<a href={item.href}>{item.label}</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.doc-related {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}

	.doc-related__title {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	.doc-related__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.doc-related__list a {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		font-size: 0.875rem;
		line-height: 1.35;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.doc-related__list a:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-accent);
		background: var(--sl-color-gray-6);
	}

	:global([data-theme='light']) .doc-related__list a {
		background: var(--color-gray-100);
		color: var(--color-gray-700);
		border-color: var(--color-gray-300);
	}

	@media print {
		.doc-related {
			display: none;
		}
	}
</style>
