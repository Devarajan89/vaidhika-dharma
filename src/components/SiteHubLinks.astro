---
import { resolveHomeLocale } from '../data/home';

const locale = resolveHomeLocale(Astro.locals.starlightRoute.locale);
const isIast = locale === 'iast';
const prefix = isIast ? '/iast' : '';

const links = [
	{ href: isIast ? '/iast/' : '/', label: isIast ? 'Home' : 'मुखम्' },
	{
		href: `${prefix}/aswalayana-sandhyavandanam/prata/`,
		label: isIast ? 'Sandhyā' : 'सन्ध्या',
	},
	{ href: `${prefix}/sri-rudra-prashnah/`, label: isIast ? 'Rudram' : 'रुद्रम्' },
	{ href: `${prefix}/purusha-suktam/`, label: isIast ? 'Puruṣa sūktam' : 'पुरुष सूक्तम्' },
	{ href: `${prefix}/rigveda-samhita/`, label: isIast ? 'Ṛgveda' : 'ऋग्वेद' },
	{ href: `${prefix}/isha-upanishad/`, label: isIast ? 'Upaniṣad' : 'उपनिषद्' },
];

const navLabel = isIast ? 'Popular pages' : 'प्रमुख पृष्ठाः';
---

<nav class="site-hubs" aria-label={navLabel}>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.site-hubs {
		margin-top: 0.25rem;
	}

	.site-hubs ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-hubs a {
		font-size: 0.8125rem;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}

	.site-hubs a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}

	:global([data-theme='light']) .site-hubs a {
		color: var(--color-gray-700);
	}

	@media print {
		.site-hubs {
			display: none;
		}
	}
</style>
