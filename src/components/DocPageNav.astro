---
import { getDocPageNav } from '../data/doc-page-nav';

const { entry, locale } = Astro.locals.starlightRoute;
const nav = getDocPageNav(entry, locale);

const hasTrikala = nav.trikalaLinks && nav.trikalaLinks.length > 0;
const hasChips = nav.contextChips && nav.contextChips.length > 0;

if (!nav.localeSwitch && !hasTrikala && !hasChips) {
	return null;
}
---

<nav class="doc-page-nav" aria-label="Page navigation">
	{
		hasChips && (
			<div class="doc-page-nav__chips">
				{nav.contextChips!.map((chip) => (
					<span class="doc-page-nav__chip">{chip.label}</span>
				))}
			</div>
		)
	}
	<div class="doc-page-nav__row">
		{
			hasTrikala && (
				<div class="doc-page-nav__trikala" role="group" aria-label="Sandhyā time">
					{nav.trikalaLinks!.map((link) =>
						link.isCurrent ? (
							<span class="doc-page-nav__trikala-item is-current" aria-current="page">
								{link.label}
							</span>
						) : (
							<a class="doc-page-nav__trikala-item" href={link.href}>
								{link.label}
							</a>
						)
					)}
				</div>
			)
		}
		{
			nav.localeSwitch && (
				<a class="doc-page-nav__locale" href={nav.localeSwitch.href}>
					{nav.localeSwitch.label}
				</a>
			)
		}
	</div>
</nav>

<style>
	.doc-page-nav {
		margin-top: 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.doc-page-nav__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.doc-page-nav__chip {
		display: inline-block;
		padding: 0.2rem 0.65rem;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--sl-color-gray-2);
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
	}

	:global([data-theme='light']) .doc-page-nav__chip {
		background: var(--color-gray-100);
		color: var(--color-gray-700);
		border-color: var(--color-gray-300);
	}

	.doc-page-nav__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
	}

	.doc-page-nav__trikala {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.2rem;
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	:global([data-theme='light']) .doc-page-nav__trikala {
		background: var(--color-gray-100);
		border-color: var(--color-gray-300);
	}

	.doc-page-nav__trikala-item {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		font-size: 0.875rem;
		line-height: 1.35;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		border-radius: 0.375rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.doc-page-nav__trikala-item:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.doc-page-nav__trikala-item.is-current {
		font-weight: 600;
		color: var(--sl-color-white);
		background: var(--sl-color-accent);
	}

	:global([data-theme='light']) .doc-page-nav__trikala-item {
		color: var(--color-gray-700);
	}

	:global([data-theme='light']) .doc-page-nav__trikala-item:hover {
		background: var(--color-gray-200);
		color: var(--color-gray-900);
	}

	:global([data-theme='light']) .doc-page-nav__trikala-item.is-current {
		color: var(--sl-color-white);
	}

	.doc-page-nav__locale {
		flex-shrink: 0;
		padding: 0.35rem 0.85rem;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.35;
		color: var(--sl-color-accent);
		text-decoration: none;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.375rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.doc-page-nav__locale:hover {
		background: var(--sl-color-accent);
		color: var(--sl-color-white);
	}

	@media (max-width: 40rem) {
		.doc-page-nav__row {
			flex-direction: column;
			align-items: stretch;
		}

		.doc-page-nav__trikala {
			width: 100%;
		}

		.doc-page-nav__locale {
			text-align: center;
		}
	}
</style>
