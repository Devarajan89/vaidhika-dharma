---
import { Image } from 'astro:assets';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import { getHeroContent, resolveHomeLocale } from '../data/home';
import Breadcrumbs from './Breadcrumbs.astro';

const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const isSplash = data.template === 'splash';
const locale = resolveHomeLocale(Astro.locals.starlightRoute.locale);
const localeHero = getHeroContent(locale);
const frontmatterHero = data.hero ?? {};

const title = isSplash ? localeHero.title : (frontmatterHero.title ?? data.title);
const tagline = isSplash ? localeHero.tagline : frontmatterHero.tagline;
const gloss = isSplash ? localeHero.gloss : undefined;
const actions = isSplash ? localeHero.actions : (frontmatterHero.actions ?? []);
const image = frontmatterHero.image;
const heroImageAlt =
	isSplash ? 'Śrī Śaṅkarācārya' : image && 'alt' in image && image.alt ? String(image.alt) : '';

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<Breadcrumbs />
<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				widths={[320, 480, 640]}
				sizes="(max-width: 50rem) 80vw, 20rem"
				width={darkImage.width}
				height={darkImage.height}
				loading="eager"
				decoding="async"
				fetchpriority="high"
				alt={heroImageAlt}
				class:list={['hero-image', { 'light:sl-hidden': Boolean(lightImage) }]}
			/>
		)
	}
	{
		lightImage && (
			<Image
				src={lightImage}
				widths={[320, 480, 640]}
				sizes="(max-width: 50rem) 80vw, 20rem"
				width={lightImage.width}
				height={lightImage.height}
				loading="eager"
				decoding="async"
				fetchpriority="high"
				alt={heroImageAlt}
				class="hero-image dark:sl-hidden"
			/>
		)
	}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
			{gloss && <p class="hero-gloss">{gloss}</p>}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name ?? icon} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: start;
			gap: 1.25rem;
			padding-bottom: 1.5rem;
			margin-bottom: 0.5rem;
			border-bottom: 1px solid var(--sl-color-gray-5);
			overflow: visible;
		}

		.hero-image,
		.hero > .hero-html {
			object-fit: contain;
			width: auto;
			max-width: min(100%, 14rem);
			max-height: none;
			height: auto;
			margin-inline: auto;
			align-self: center;
			order: 2;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.25rem, calc(1rem + 1vw), 2rem);
			text-align: center;
			order: 1;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-lg));
			line-height: 1.9;
			color: var(--sl-color-gray-3);
		}

		.hero-gloss {
			margin: 0;
			font-size: var(--sl-text-sm);
			line-height: 1.55;
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2rem, calc(1rem + 8vmin), 8rem);
			}

			.hero-image,
			.hero > .hero-html {
				order: 2;
				max-width: 100%;
				max-height: none;
				align-self: start;
			}

			.stack {
				text-align: start;
				order: 0;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
